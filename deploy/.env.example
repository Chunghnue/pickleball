# Copy to deploy/.env and fill in. Consumed by docker-compose.prod.yml via
# `--env-file deploy/.env` (the deploy scripts pass this automatically).

# --- Database ---------------------------------------------------------------
DB_USERNAME=pickleball
DB_PASSWORD=change-me-db-password
DB_NAME=pickleball

# --- Auth (REQUIRED) ------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Mail -----------------------------------------------------------------
# Defaults target the bundled mailhog (`--profile mail`). Point at a real
# SMTP host in production.
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@pickleball.local

# --- URLs ---------------------------------------------------------------
# Public origin of the web app; used for links in outgoing emails.
APP_URL=https://pickleball.divusoft.com

# --- Web build args -----------------------------------------------------
# Baked into the web image at build time (NEXT_PUBLIC_*). Rebuild web after
# changing this. Leave empty to disable the map feature.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
